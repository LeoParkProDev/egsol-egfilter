# 견적 폼 → Gmail 발송 설정 (Vercel 프로젝트 환경변수에 동일하게 등록)
#
# 1) Google 계정(egfilter153@gmail.com) → 보안 → 2단계 인증 켜기
# 2) 보안 → 앱 비밀번호 → 앱 이름 "evergreen-quote" → 생성된 16자리를 아래에
#    (일반 비밀번호가 아니라 '앱 비밀번호'여야 SMTP가 열립니다)
# 3) Vercel → 프로젝트 → Settings → Environment Variables 에 3개 등록 후 Redeploy
#
# 환경변수가 없으면 폼은 자동으로 mailto 방식으로 동작합니다(사이트가 깨지지 않음).

GMAIL_USER=egfilter153@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 받을 주소 (비우면 GMAIL_USER와 동일한 site.ts의 email로 발송)
QUOTE_TO=egfilter153@gmail.com

# ─────────────────────────────────────────────────────────────
# 전환 추적 (선택 — 비워두면 분석 스크립트가 아예 주입되지 않고 사이트는 그대로 동작합니다)
# 발급·등록 절차는 docs/전환추적-설정.md 참고
#
# GA4 측정 ID: analytics.google.com → 관리 → 데이터 스트림 → 웹 → "G-"로 시작하는 값
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# 네이버 프리미엄 로그분석: 검색광고 시스템 → 도구 → 프리미엄 로그분석
# 공통 스크립트의 wcs_add["wa"]="여기 값" 만 적습니다
NEXT_PUBLIC_NAVER_WCS_ID=xxxxxxxxxxxx
